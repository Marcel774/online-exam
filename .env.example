# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY=

# APP_URL: Public URL of the hosted application.
APP_URL=http://localhost:3000

# PORT: Server port (must be 3000 in AI Studio).
PORT=3000

# MONGODB_URI: MongoDB Atlas or self-hosted MongoDB connection string.
# Leave blank in local development to use the embedded MongoDB engine automatically.
MONGODB_URI=

# CORS_ORIGIN: Comma-separated allowed origins for production cross-origin deployments (e.g. Vercel frontend URL).
CORS_ORIGIN=

# ADMIN_BOOTSTRAP_PASSCODE: Optional initial admin setup passcode for first-run environments.
ADMIN_BOOTSTRAP_PASSCODE=
